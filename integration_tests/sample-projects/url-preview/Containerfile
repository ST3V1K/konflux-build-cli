# Build the url-preview sample service binary.
FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7@sha256:7ec4dc8858bd3467b5e13ecccc9f913a0908978e50420958922d4494bf7b65b9 AS builder

ARG TARGETOS
ARG TARGETARCH

USER 1001

WORKDIR /workspace

COPY --chown=1001:0 go.mod go.sum ./
RUN go mod download

COPY --chown=1001:0 . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o url-preview .

# Run the service from a minimal image. distroless/static already bundles
# a CA trust store and a non-root "nonroot" user (uid 65532).
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /workspace/url-preview ./url-preview
COPY --from=builder /workspace/static ./static

ENV PORT=8080
ENV REQUEST_TIMEOUT_SECONDS=10
EXPOSE 8080

ENTRYPOINT ["./url-preview"]
